# MeetingMind environment — copy to .env and fill in. NEVER commit .env.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Local dev (SQLite). Production Postgres example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/meetingmind
DATABASE_URL=sqlite:///./meetingmind.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AI provider: "rules" (offline default) or "openai-compatible"
AI_PROVIDER=rules
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
MAX_UPLOAD_BYTES=524288
